{
  "name": "@aileron/dashboard-new",
  "exports": "./main.ts",
  "tasks": {
    "generate": "tsr generate",
    "dev": "tsr watch & deno run -A --unstable-no-legacy-abort npm:vite dev",
    "build": "vite build",
    "start": "deno run -A --unstable-no-legacy-abort .output/server/index.mjs",
    "compile": "deno task build && deno compile -A --unstable-no-legacy-abort --include=.output/public --output=dist/aileron-dashboard .output/server/index.mjs",
    "format": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint"
  },
  "imports": {
    "@/": "./src/",
    "@base-ui/react": "npm:@base-ui/react@^1.6.0",
    "@base-ui/react/": "npm:/@base-ui/react@^1.6.0/",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@fontsource-variable/figtree": "npm:@fontsource-variable/figtree@^5.3.0",
    "@fontsource-variable/figtree/": "npm:/@fontsource-variable/figtree@^5.3.0/",
    "@fontsource-variable/fraunces": "npm:@fontsource-variable/fraunces@^5.3.0",
    "@fontsource-variable/fraunces/": "npm:/@fontsource-variable/fraunces@^5.3.0/",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.101.4",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.170.18",
    "@tanstack/react-router-ssr-query": "npm:@tanstack/react-router-ssr-query@^1.167.1",
    "@tanstack/react-start": "npm:@tanstack/react-start@^1.168.34",
    "@tanstack/router-cli": "npm:@tanstack/router-cli@^1.167.21",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.5",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "lucide-react": "npm:lucide-react@^1.28.0",
    "nitro": "npm:nitro@3.0.260610-beta",
    "nitro/": "npm:/nitro@3.0.260610-beta/",
    "react": "npm:react@^19.2.8",
    "react/": "npm:/react@^19.2.8/",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-dom/": "npm:/react-dom@^19.2.8/",
    "shadcn": "npm:shadcn@^4.16.0",
    "shadcn/": "npm:/shadcn@^4.16.0/",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "tw-animate-css": "npm:tw-animate-css@^1.4.0",
    "vite": "npm:vite@8.2.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "deno.ns"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["src/routeTree.gen.ts", ".vite", ".tanstack"]
}
