{
  "nodeModulesDir": "auto",
  "workspace": ["apps/*"],
  "unstable": ["no-legacy-abort"],
  "tasks": {
    "check": "deno fmt --check && deno lint"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "allowScripts": {
    "allow": ["npm:@astryxdesign/cli@0.1.9", "npm:@astryxdesign/core@0.2.0"],
    "deny": ["npm:esbuild@0.25.12", "npm:esbuild@0.25.7", "npm:esbuild@0.27.7"]
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.vite/**",
    "**/.tanstack/**",
    "**/routeTree.gen.ts",
    "**/*.gen.ts",
    "crates/",
    "target/"
  ]
}
